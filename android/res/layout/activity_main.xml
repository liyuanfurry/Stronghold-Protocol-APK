<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="STRONGHOLD PROTOCOL · 安卓客户端"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="服务器地址"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="https://example.com:8443"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/dim" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="游戏页面从这里加载，联机也连这台服务器。务必带上端口号。"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="资源更新地址（可留空）"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/update_base"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="留空则用上面的服务器"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textColorHint="@color/dim" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="只在校对版本和更新资源时访问。指向镜像站或另一台服务器即可，和游戏服务器可以不同。"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="在线更新资源" />

            <Button
                android:id="@+id/play"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="开始游戏" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:max="100" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="准备就绪"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="本机服务器"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/srv_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="未启动"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="在当前手机上跑起游戏服务端（内嵌 Node，载荷约 97 MB，首次启动需解包）。同网段的设备连你的 IP 即可加入。"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/srv_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启动本机服务器" />

            <Button
                android:id="@+id/srv_use"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="让本应用连本机" />
        </LinearLayout>

        <Button
            android:id="@+id/srv_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="查看服务端日志" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="局域网"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/local_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="本机地址：读取中…"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="扫描同一 Wi-Fi 下的游戏服务器（会向网段内每个地址发一个探测请求）。点结果即可填入上面的地址栏。"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <Button
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="扫描局域网" />

        <TextView
            android:id="@+id/scan_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text=""
            android:textColor="@color/text"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/scan_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="资源版本"
            android:textColor="@color/dim"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/version_builtin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="内置资源：读取中…"
            android:textColor="@color/accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/version_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="2dp"
            android:text="服务器版本：未校对"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/version_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="已更新覆盖：无"
            android:textColor="@color/dim"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="校对版本" />

            <Button
                android:id="@+id/revert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="还原为内置" />
        </LinearLayout>

        <TextView
            android:id="@+id/footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text=""
            android:textColor="@color/dim"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="非官方、非商业同人作品，与鹰角网络 / Yostar 无关。游戏素材版权归原权利人，代码以 GPL-3.0-or-later 发布。"
            android:textColor="@color/dim"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
